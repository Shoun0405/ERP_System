# Backend environment variables — bu faylni .env ga nusxalab to'ldiring.
# .env git ga kiritilmaydi (.gitignore da). Bu namuna esa commit qilinadi.

# PostgreSQL ulanishi (5-20 user uchun pool sozlamasi bilan)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_db?connection_limit=20&pool_timeout=30"

# JWT sekret — MAJBURIY, kamida 32 belgi. Zaif default YO'Q (C-1).
# Kuchli sekret generatsiya qilish:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_kamida_32_belgilik_tasodifiy_sekret"

# Token amal qilish muddati (ixtiyoriy, default 24h)
JWT_TTL="24h"

# CORS — vergul bilan ajratilgan ruxsat etilgan originlar
CORS_ORIGIN="http://localhost:5173"

# Muhit: production da NODE_ENV=production (helmet, morgan, secure cookie faollashadi)
# NODE_ENV=production

# Ixtiyoriy: Sentry xato monitoringi
# SENTRY_DSN=
